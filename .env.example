# Copy to `.env.local` for local development. Never commit real values.

# Front-end (safe to be public: Row Level Security protects the data).
# Used from Phase 1 onward.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Server-side secrets do NOT go in any file. Set them once in your own terminal:
#   supabase secrets set CARDDEX_API_KEY=...
#   supabase secrets set ANTHROPIC_API_KEY=...
# (The Supabase service role key is provided to Edge Functions automatically.)
